# ==============================================================================
# Mandhiragiri Jothidam - Hostinger Production Environment Configuration Template
# ==============================================================================
# Production API: https://mandhiragiri.pixelplot.in
# Target Server:  Hostinger Web Apps (Node.js 24.x)
# Database Host:  srv2216.hstgr.io
#
# IMPORTANT:
# - Enter these variables in Hostinger -> Web Apps -> mandhiragiri.pixelplot.in -> Environment variables
# - DO NOT commit production secrets, DB passwords, or Firebase private keys to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
# PORT is dynamically assigned by Hostinger, or enter the port assigned in Web App settings (e.g. 5000 or 3000)
PORT=5000
CORS_ORIGIN=https://mandhiragiri.pixelplot.in

# ------------------------------------------------------------------------------
# 2. Hostinger Production MySQL Database
# ------------------------------------------------------------------------------
DB_HOST=srv2216.hstgr.io
DB_PORT=3306
DB_USER=u571023396_mandhiragiri
DB_PASSWORD=ENTER_SECURE_PASSWORD_IN_HOSTINGER_HPANEL
DB_NAME=u571023396_mandhiragiridb
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# 3. JWT Security & Session Lifetimes (Preserved from backend configuration)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=@12345mandhiragiri@KAK!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# ------------------------------------------------------------------------------
# 4. Super Admin Initial Account (Matches mandhiragiri_production_database.sql)
# ------------------------------------------------------------------------------
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_MOBILE=9876543210
SUPER_ADMIN_PASSWORD=Admin@1234
SUPER_ADMIN_EMAIL=admin@mandhiragiri.com

# ------------------------------------------------------------------------------
# 5. Astrology Engine (OneBhakthi API)
# ------------------------------------------------------------------------------
ONEBHAKTHI_BASE_URL=https://www.onebhakthi.org
ONEBHAKTHI_TIMEOUT=15000
ONEBHAKTHI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Firebase FCM Push Notifications (Choose ONE method)
# ------------------------------------------------------------------------------
# Method A (Recommended for Web Apps): Base64 encoded service account JSON string
# Generate via PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("src/config/firebase-service-account.json"))
# FIREBASE_SERVICE_ACCOUNT_BASE64=
#
# Method B: Minified raw JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Method C: Upload 'firebase-service-account.json' directly to 'src/config/' on Hostinger via File Manager
